# ======================================================================
# LeadOps configuration. Copy to .env and fill in. Never commit .env.
# ======================================================================

# --- Basics -----------------------------------------------------------
PUBLIC_BASE_URL=https://n8n.yourschool.example   # public HTTPS URL of n8n (no trailing slash)
N8N_DOMAIN=n8n.yourschool.example                # used by Caddy for the HTTPS certificate
TIMEZONE=Asia/Dubai                               # Asia/Riyadh, Asia/Qatar, ...
SCHOOL_NAME="Palm Crescent International School"
DEFAULT_COUNTRY_CODE=971                          # 966 KSA, 974 Qatar, 965 Kuwait, 973 Bahrain, 968 Oman
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- Database ---------------------------------------------------------
POSTGRES_USER=leadops
POSTGRES_PASSWORD=change-me

# --- Dashboard login (basic auth) -------------------------------------
DASHBOARD_USER=admissions
DASHBOARD_PASSWORD=change-me

# --- Meta Lead Ads (docs/SETUP.md, part 2) ----------------------------
META_VERIFY_TOKEN=any-random-string-you-also-paste-in-meta
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=                           # long-lived page token
META_PAGE_TOKENS=                                 # optional JSON for several pages: {"PAGE_ID":"TOKEN"}
META_GRAPH_VERSION=v26.0
ALLOW_TEST_LEADS=true                             # signed test leads from tests/ ; set false in production

# --- CRM: Zoho Bigin (docs/SETUP.md, part 3) --------------------------
CRM_PROVIDER=bigin                                # bigin | none
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com       # .eu / .sa / .in ... must match the account's data centre
BIGIN_API_BASE=https://www.zohoapis.com/bigin/v2  # zohoapis.sa for Saudi data centre, etc.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
BIGIN_FIELD_CHANNEL=                              # optional custom field API names, e.g. Lead_Channel
BIGIN_FIELD_CAMPAIGN=
BIGIN_FIELD_LANGUAGE=

# --- Notifications ----------------------------------------------------
TELEGRAM_BOT_TOKEN=                               # from @BotFather
ALERT_TELEGRAM_CHAT_ID=                           # operator chat for system alerts
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=admissions@yourschool.example
ALERT_EMAIL=

# --- Website form -----------------------------------------------------
WEB_FORM_KEY=                                     # optional shared key for server-to-server posts
MAX_ATTEMPTS=6                                    # retries before an event is parked for manual replay
