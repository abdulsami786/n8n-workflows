# ======================================================================
# LeadOps LOCAL config (Windows, no Docker, mock providers).
# setup-local.ps1 copies this to .env and replaces every change-me with a random value.
# For a real server use .env.example and docs/SETUP.md instead.
# ======================================================================

# --- Basics -----------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:5678
N8N_DOMAIN=
TIMEZONE=Asia/Dubai                               # Asia/Riyadh, Asia/Qatar, ...
SCHOOL_NAME="Palm Crescent International School"
DEFAULT_COUNTRY_CODE=971                          # 966 KSA, 974 Qatar, 965 Kuwait, 973 Bahrain, 968 Oman
N8N_ENCRYPTION_KEY=change-me

# --- Database ---------------------------------------------------------
POSTGRES_USER=leadops
POSTGRES_PASSWORD=change-me

# --- Dashboard login (basic auth) -------------------------------------
DASHBOARD_USER=admissions
DASHBOARD_PASSWORD=change-me

# --- Meta Lead Ads (docs/SETUP.md, part 2) ----------------------------
META_VERIFY_TOKEN=change-me
META_APP_SECRET=change-me
META_PAGE_ACCESS_TOKEN=mock                        # mock: any value, the mock Graph API ignores it
META_PAGE_TOKENS=                                 # optional JSON for several pages: {"PAGE_ID":"TOKEN"}
META_GRAPH_VERSION=v26.0
META_GRAPH_BASE=http://localhost:5678/webhook/mock-graph        # mock; remove for the real Graph API
ALLOW_TEST_LEADS=true                             # signed test leads from tests/ ; set false in production

# --- CRM: Zoho Bigin (docs/SETUP.md, part 3) --------------------------
CRM_PROVIDER=bigin                                # mock Bigin (n8n/mocks); set none to skip the CRM
ZOHO_ACCOUNTS_URL=http://localhost:5678/webhook/mock-zoho       # mock
BIGIN_API_BASE=http://localhost:5678/webhook/mock-bigin         # mock
ZOHO_CLIENT_ID=mock
ZOHO_CLIENT_SECRET=mock
ZOHO_REFRESH_TOKEN=mock
BIGIN_FIELD_CHANNEL=                              # optional custom field API names, e.g. Lead_Channel
BIGIN_FIELD_CAMPAIGN=
BIGIN_FIELD_LANGUAGE=

# --- Notifications ----------------------------------------------------
TELEGRAM_BOT_TOKEN=mock                           # mock; put the real @BotFather token here
TELEGRAM_API_BASE=http://localhost:5678/webhook/mock-telegram  # mock; remove for real Telegram
ALERT_TELEGRAM_CHAT_ID=100000009                  # mock chat id
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=admissions@yourschool.example
ALERT_EMAIL=

# --- Website form -----------------------------------------------------
WEB_FORM_KEY=                                     # optional shared key for server-to-server posts
MAX_ATTEMPTS=6                                    # retries before an event is parked for manual replay
