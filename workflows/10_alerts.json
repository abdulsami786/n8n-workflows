            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c29d5248-8d64-5fae-94f5-59038b22e352",
              "leftValue": "={{ ($env.SMTP_ENABLED || 'false') === 'true' && !!$env.ALERT_EMAIL }}",
              "rightValue": "",
              "operator": {
