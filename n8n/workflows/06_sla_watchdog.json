  "name": "LeadOps 06 · SLA watchdog (reminders and escalation)",
  "nodes": [
    {
      "parameters": {
        "content": "## SLA watchdog\nEvery minute: unclaimed inquiries get a reminder every N minutes (per routing rule), and are escalated to the rule's manager once the promised response time has passed.\n\nThe SQL bumps counters in the same statement that selects them (FOR UPDATE SKIP LOCKED), so overlapping runs never double-remind. Successful runs are not saved (keeps the DB small).",
        "height": 280,
        "width": 380,
        "color": 7
      },
      "id": "89063e00-a770-582e-9a37-8c3895ad5665",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -440,
        -80
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
