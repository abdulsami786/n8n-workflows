{
  "id": "lo02WebIntake000",
  "name": "LeadOps 02 · Website form intake",
  "nodes": [
    {
      "parameters": {
        "content": "## Website form intake\nAccepts JSON or form posts from any website form (custom HTML, WordPress plugins, Webflow...).\n\nSpam traps (honeypot + too-fast submit), validation, idempotency (submission_id or content fingerprint), durable inbox, instant answer to the browser with a reference number, then processing.\n\nEnv: WEB_FORM_KEY (optional)",
        "height": 300,
        "width": 380,
        "color": 7
      },
      "id": "61596037-5edb-5449-99b0-80be3689d6c4",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -440,
        -80
      ]
    },
    {
      "parameters": {
        "path": "leadops/web-form",
        "responseMode": "responseNode",
        "options": {},
        "httpMethod": "POST"
      },
      "id": "2ff2e7ed-3ac7-5022-80a7-69ff8f5a3145",
      "name": "Website form",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "fb7030ef-d2fc-5fc4-a014-7fc5fce2d1dc"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "11a48890-e885-5eaa-a7a7-4f41e2546b46",
              "name": "form_key",
              "value": "={{ $env.WEB_FORM_KEY || '' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "72212c99-0374-5584-ae3f-7f08c44aad37",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Validates a website submission. Returns one item with decision = accept | reject | spam.\nconst req = $('Website form').first().json;\nconst cfg = $('Config').first().json;\nconst headers = req.headers || {};\nlet body = req.body;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) { body = {}; } }\nif (!body || typeof body !== 'object' || Array.isArray(body)) body = {};\n// Some form builders nest fields as { fields: {...} } or { data: {...} }\nconst src = (body.fields && typeof body.fields === 'object' && !Array.isArray(body.fields)) ? body.fields\n  : (body.data && typeof body.data === 'object' && !Array.isArray(body.data)) ? body.data : body;\nconst get = (...keys) => {\n  for (const k of keys) { const v = src[k]; if (v !== undefined && v !== null && String(v).trim() !== '') return String(v).trim(); }\n  return '';\n};\n\n// 1) Optional shared key (for server-to-server posts from a CMS / form plugin)\nif (cfg.form_key && get('key', '_key') !== cfg.form_key && String(headers['x-leadops-key'] || '') !== cfg.form_key) {\n  return [{ json: { decision: 'reject', status: 401, errors: ['invalid form key'] } }];\n}\n// 2) Spam traps: hidden honeypot field + \"submitted faster than a human could type\"\nconst honeypot = get('website', 'company_website', 'hp', '_hp');\nconst started = Number(get('form_started_at', '_ts'));\nconst tooFast = started > 1e12 && Date.now() - started < 2500;\nif (honeypot || tooFast) return [{ json: { decision: 'spam', status: 200, errors: [] } }];\n\n// 3) Minimal validation (the processor does full normalization)\nconst name = get('name', 'full_name', 'fullname', 'parent_name', 'your-name', 'first_name', 'firstname');\nconst phone = get('phone', 'mobile', 'phone_number', 'tel', 'telephone', 'whatsapp', 'your-phone', 'contact_number');\nconst email = get('email', 'email_address', 'your-email', 'mail');\nconst errors = [];\nif (!name) errors.push('name is required');\nif (!phone && !email) errors.push('phone or email is required');\nif (email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)) errors.push('email looks invalid');\nif (phone && phone.replace(/[^\\d\\u0660-\\u0669\\u06F0-\\u06F9]/g, '').length < 7) errors.push('phone looks too short');\nif (errors.length) return [{ json: { decision: 'reject', status: 422, errors } }];\n\n// 4) Idempotency key: client submission id, else a content fingerprint per 10-minute bucket\nconst sid = get('submission_id', 'submissionId', '_sid');\nconst bucket = Math.floor(Date.now() / 600000);\nconst eventKey = sid\n  ? 'sid:' + sid.slice(0, 120)\n  : 'fp:' + [email.toLowerCase(), phone.replace(/\\D/g, ''), get('message', 'comments', 'your-message').slice(0, 120), bucket].join('|');\nconst fields = {};\nfor (const [k, v] of Object.entries(src)) {\n  if (!['website', 'company_website', 'hp', '_hp', 'key', '_key'].includes(k)) fields[k] = v;\n}\nreturn [{ json: {\n  decision: 'accept', status: 200, errors: [], event_key: eventKey,\n  payload: { fields, meta: {\n    received_at: new Date().toISOString(),\n    ip: String(headers['x-forwarded-for'] || headers['x-real-ip'] || '').split(',')[0].trim() || null,\n    user_agent: headers['user-agent'] || null,\n    origin: headers.origin || null,\n    referer: headers.referer || null,\n  } },\n} }];\n"
      },
      "id": "ad822f0a-9c80-5cef-8fe4-fc30bee96139",
      "name": "Validate submission",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
