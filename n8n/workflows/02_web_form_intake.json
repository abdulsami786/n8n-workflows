      "id": "5408bda9-1fda-59f2-9b2f-cd0f82227c26",
      "name": "Answer: rejected or spam",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        960,
        180
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ins AS (\n  INSERT INTO leadops.inbox (source, event_key, payload) VALUES ('web', $1, $2::jsonb)\n  ON CONFLICT (source, event_key) DO NOTHING\n  RETURNING id\n)\nSELECT coalesce((SELECT id FROM ins),\n                (SELECT id FROM leadops.inbox WHERE source = 'web' AND event_key = $1)) AS inbox_id,\n       EXISTS (SELECT 1 FROM ins) AS is_new;",
        "options": {
          "queryReplacement": "={{ [ $json.event_key, $json.payload ] }}"
        }
      },
      "id": "4209d49a-e61e-5da1-acf4-236243b98a0d",
      "name": "Save to inbox",
