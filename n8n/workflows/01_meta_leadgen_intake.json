    {
      "parameters": {
        "jsCode": "// Meta batches several leads per request (entry[] -> changes[]).\n// Meta IDs can exceed JavaScript's safe-integer range, so long numeric IDs are\n// quoted in the RAW body before JSON.parse (otherwise the last digits get rounded\n// and the Graph API lookup fails with \"object does not exist\").\nconst raw = $('Raw body as text').first().json.rawBody || '';\nconst safeRaw = raw.replace(/\"(leadgen_id|page_id|form_id|ad_id|adgroup_id|id)\"\\s*:\\s*(\\d{15,})/g, '\"$1\":\"$2\"');\nlet body;\ntry { body = JSON.parse(safeRaw); } catch (e) { throw new Error('Meta payload is not valid JSON: ' + e.message); }\nconst events = [];\nfor (const entry of Array.isArray(body.entry) ? body.entry : []) {\n  for (const change of Array.isArray(entry.changes) ? entry.changes : []) {\n    const v = change && change.value;\n    if (!change || change.field !== 'leadgen' || !v || v.leadgen_id == null) continue;\n    events.push({\n      leadgen_id: String(v.leadgen_id),\n      page_id: v.page_id != null ? String(v.page_id) : (entry.id != null ? String(entry.id) : null),\n      form_id: v.form_id != null ? String(v.form_id) : null,\n      ad_id: v.ad_id != null ? String(v.ad_id) : null,\n      adgroup_id: v.adgroup_id != null ? String(v.adgroup_id) : null,\n      created_time: v.created_time != null ? v.created_time : null,\n      // Only present in signed payloads from tests/send_meta_test_lead.sh\n      test_lead: v.test_lead || null,\n    });\n  }\n}\nreturn [{ json: { object: body.object || null, event_count: events.length, events } }];\n"
      },
      "id": "645bf307-9c32-5850-a338-a2ec45ebd3d3",
      "name": "Extract leadgen events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ev AS (\n  SELECT e->>'leadgen_id' AS key, e AS payload FROM jsonb_array_elements($1::jsonb) e\n), ins AS (\n  INSERT INTO leadops.inbox (source, event_key, payload)\n  SELECT 'meta', key, payload FROM ev\n  ON CONFLICT (source, event_key) DO NOTHING\n  RETURNING id\n)\nSELECT (SELECT count(*) FROM ev) AS received,\n       coalesce((SELECT jsonb_agg(id ORDER BY id) FROM ins), '[]'::jsonb) AS new_ids;",
        "options": {
          "queryReplacement": "={{ [ JSON.stringify($json.events) ] }}"
        }
      },
