    {
      "parameters": {
        "jsCode": "// Builds the Bigin contact, the search criteria and the inquiry note.\nconst cfg = $('Config').first().json;\nconst inq = $('Load inquiry').first().json.inq;\nif (!inq) throw new Error('Inquiry not found for CRM sync');\nconst L = inq.lead || {};\nconst channel = { meta: 'Facebook/Instagram lead form', web: 'Website form', whatsapp: 'WhatsApp' }[inq.channel] || inq.channel;\nconst langName = { ar: 'Arabic', en: 'English', fr: 'French', ur: 'Urdu', hi: 'Hindi' }[inq.language] || inq.language || '';\nconst first = String(L.first_name || '').trim();\nconst last = String(L.last_name || '').trim();\nconst contact = {\n  First_Name: last ? (first || undefined) : undefined,\n  Last_Name: (last || first || L.full_name || 'Unknown').slice(0, 80),   // Bigin requires Last_Name\n  Email: L.email || undefined,\n  Mobile: L.phone_e164 || undefined,\n  Description: [\n    `First inquiry: ${channel}${inq.campaign_name ? ' - ' + inq.campaign_name : ''}`,\n    langName ? `Language: ${langName}` : null,\n    `LeadOps family #${L.lead_id}`,\n  ].filter(Boolean).join('\\n'),\n};\nif (cfg.field_channel) contact[cfg.field_channel] = channel;\nif (cfg.field_campaign && inq.campaign_name) contact[cfg.field_campaign] = String(inq.campaign_name).slice(0, 250);\nif (cfg.field_language && langName) contact[cfg.field_language] = langName;\nObject.keys(contact).forEach((k) => contact[k] === undefined && delete contact[k]);\n\n// Zoho criteria syntax: escape ( ) , and backslash inside values\nconst esc = (v) => String(v).replace(/([(),\\\\])/g, '\\\\$1');\nconst parts = [];\nif (L.email) parts.push(`(Email:equals:${esc(L.email)})`);\nif (L.phone_e164) parts.push(`(Mobile:equals:${esc(L.phone_e164)})`);\nconst criteria = parts.length > 1 ? `(${parts.join('or')})` : parts[0];\n\nconst noteLines = [\n  `Channel: ${channel}`,\n  inq.campaign_name ? `Campaign: ${inq.campaign_name}` : null,\n  inq.adset_name ? `Ad set: ${inq.adset_name}` : null,\n  inq.ad_name ? `Ad: ${inq.ad_name}` : null,\n  inq.form_name ? `Form: ${inq.form_name}` : null,\n  inq.utm_source ? `UTM: ${[inq.utm_source, inq.utm_medium, inq.utm_campaign].filter(Boolean).join(' / ')}` : null,\n  inq.page_url ? `Page: ${inq.page_url}` : null,\n  langName ? `Language: ${langName}` : null,\n  `Received: ${inq.received_at}`,\n  ...Object.entries(inq.answers || {}).map(([k, v]) => `${k}: ${v}`),\n  inq.message ? `Message: ${inq.message}` : null,\n  inq.status === 'merged' ? 'Same family submitted again within the dedupe window (merged, no new alert).' : null,\n  `LeadOps inquiry #${inq.inquiry_id}`,\n].filter(Boolean);\nreturn [{ json: {\n  known_id: inq.crm_record_id || L.crm_record_id || null,\n  contact,\n  criteria,\n  note: {\n    Note_Title: `${inq.status === 'merged' || inq.is_repeat ? 'Repeat' : 'New'} inquiry via ${channel}${inq.campaign_name ? ' - ' + inq.campaign_name : ''}`.slice(0, 120),\n    Note_Content: noteLines.join('\\n'),\n  },\n} }];\n"
      },
