    {
      "parameters": {
        "jsCode": "// Resolves the Bigin contact id from whichever path ran: known id, search hit or create.\nconst safe = (n) => { try { const it = $(n).first(); return it ? it.json : null; } catch (e) { return null; } };\nconst built = $('Build Bigin payload').first().json;\nif (built.known_id) return [{ json: { contact_id: String(built.known_id), crm_action: 'known' } }];\nconst s = safe('Search contact');\nconst hit = s && Number(s.statusCode) === 200 && s.body && Array.isArray(s.body.data) ? s.body.data[0] : null;\nif (hit && hit.id) return [{ json: { contact_id: String(hit.id), crm_action: 'matched' } }];\nconst c = safe('Create contact');\nconst row = c && Array.isArray(c.data) ? c.data[0] : null;\nif (row && row.code === 'SUCCESS' && row.details && row.details.id) {\n  return [{ json: { contact_id: String(row.details.id), crm_action: 'created' } }];\n}\nif (row && row.code === 'DUPLICATE_DATA' && row.details) {\n  const id = (row.details.duplicate_record && row.details.duplicate_record.id) || row.details.id;\n  if (id) return [{ json: { contact_id: String(id), crm_action: 'matched' } }];\n}\nthrow new Error('Bigin did not return a contact id: ' + JSON.stringify(c || s || {}).slice(0, 600));\n"
      },
