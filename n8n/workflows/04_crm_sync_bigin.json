    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT leadops.inquiry_json($1::bigint) AS inq;",
        "options": {
          "queryReplacement": "={{ [ $('Start').first().json.inquiry_id ] }}"
        }
      },
      "id": "00c9e13b-27df-555e-a82a-85b47437ab72",
      "name": "Load inquiry",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        0
      ],
      "credentials": {
        "postgres": {
