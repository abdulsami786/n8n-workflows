            "title": "={{ $json.r.status === 'dead' ? 'Lead event gave up after ' + $json.r.attempts + ' attempts (needs manual replay)' : 'Lead event failed, retrying automatically' }}",
            "detail": "={{ 'Inbox #' + $json.r.inbox_id + ' (' + $json.r.source + ', ' + $json.r.event_key + ')\\nError: ' + $json.r.last_error + '\\nNext retry: ' + ($json.r.status === 'dead' ? 'none, replay manually' : $json.r.next_retry_at) }}",
            "fingerprint": "={{ 'inbox:' + $json.r.inbox_id + ':' + $json.r.status }}"
          },
          "matchingColumns": [],
