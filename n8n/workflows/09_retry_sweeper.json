    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT leadops.mark_inbox_failed($1::bigint, $2::text, $3::int) AS r;",
        "options": {
          "queryReplacement": "={{ [ $('Current event').first().json.inbox_id, typeof $json.error === 'string' ? $json.error : ($json.error?.message || $json.message || JSON.stringify($json.error || 'Processing failed')), Number($env.MAX_ATTEMPTS || 6) ] }}"
        }
      },
      "id": "8290d028-4062-5ee3-a783-efa792dc1ecc",
      "name": "Schedule retry",
