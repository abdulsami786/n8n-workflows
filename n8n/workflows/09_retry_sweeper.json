        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "6a4c07ba-05f3-5f29-a0b7-0c7cce6505a1",
              "leftValue": "={{ !!$json.r && ($json.r.status === 'dead' || $json.r.attempts <= 1) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
